services:
  php81:
    build: 
      context: ./php8.1/alpine
      dockerfile: Dockerfile-phpredis
    container_name: php81
    volumes:
      - ${WEB_VOLUME}:/var/www/
    networks:
      - app
      - data

  php84:
    build: 
      context: ./php8.4/alpine
      args:
        UID: ${UID}
        GID: ${GID}
      dockerfile: Dockerfile-php84redis
    container_name: php84
    user: "${UID}:${GID}"
    volumes:
      - ${WEB_VOLUME}:/var/www/
    networks:
      - app
      - data

  mysql8:
    container_name: mysql8
    image: mysql:8.0
    command: --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    ports:
      - "3325:3306"
    volumes:
      - ./mysql/data:/var/lib/mysql
    networks:
      - data
  
  nginx:
    build: ./nginx/alpine
    container_name: nginx
    ports:
      - "8084:80" #nginx
      - "8085:8085" #busur
      - "8086:8086" #lapakreina
      - "8087:8087" #inventory
      - "8088:8088" #oyisam
    volumes:
      - ${WEB_VOLUME}:/var/www/
      - ./nginx/conf/sites-enabled/:/etc/nginx/sites-enabled/
      - ./nginx/logs/:/var/log/nginx/
      - /tmp/:/tmp/
      - /etc/localtime:/etc/localtime:ro
    networks:
      - app
  
  mongo:
    container_name: mongo
    image: mongo:6
    restart: always
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_ROOT_USER}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_ROOT_PASS}
    ports:
      - "27027:27017"
    volumes:
      - ./mongodb/data:/data/db
      - ./mongodb/config:/data/configdb
    networks:
      - data
  
  mongo-express:
    image: mongo-express:latest
    container_name: mongo-express
    restart: always
    ports:
      - "8089:8081"
    environment:
      ME_CONFIG_MONGODB_ADMINUSERNAME: ${MONGO_ROOT_USER}
      ME_CONFIG_MONGODB_ADMINPASSWORD: ${MONGO_ROOT_PASS}
      ME_CONFIG_BASICAUTH_USERNAME: ${MONGO_BASICAUTH_USER}
      ME_CONFIG_BASICAUTH_PASSWORD: ${MONGO_BASICAUTH_PASS}
      ME_CONFIG_MONGODB_SERVER: mongo
    networks:
      - data

  node-wa:
    build:
      context: ${NODE_VOLUME}/wa-service-v2
      dockerfile: Dockerfile
    container_name: node-wa
    working_dir: /app
    tty: true
    stdin_open: true
    ports:
      - "3001:3001"
    volumes:
      - ${NODE_VOLUME}/wa-service-v2:/app
      - /app/node_modules
      - ${NODE_VOLUME}/wa-service-v2/sessions:/app/storage/sessions
    restart: unless-stopped
    networks:
      - app
      - data
  
  # tiktok-bridge:
  #   build:
  #     context: ${WEB_VOLUME}/game
  #     dockerfile: Dockerfile
  #   container_name: neon-dodge-bridge
  #   ports:
  #     - "3000:3000"
  #   restart: always
  #   # Menghubungkan folder lokal ke container agar perubahan kode langsung sinkron
  #   volumes:
  #     - ${WEB_VOLUME}/game:/app
  #     - /app/node_modules

networks:
  app:
    driver: bridge

  data:
    driver: bridge